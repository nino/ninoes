# Copy to .env and fill in. Both values are in the Supabase dashboard under
# Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. PostHog page views and error tracking; leave empty to send nothing.
# Production sets them in .github/workflows/fly-deploy.yml.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Optional. Backblaze B2 for /blog-images; production sets them as Fly secrets.
# Server-side only: no VITE_ prefix, so they never reach the browser. Anything
# left empty here is read from ~/.config/image-uploader/.env instead. Without
# them, /blog-images can only keep files on this machine.
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
BUCKET_NAME=
BUCKET_URL=
