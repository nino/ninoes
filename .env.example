# Copy to .env and fill in. Both values are in the Supabase dashboard under
# Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. PostHog page views and error tracking; leave empty to send nothing.
# Production sets them in .github/workflows/fly-deploy.yml.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
