# Copy to .env and fill in. Both values are in the Supabase dashboard under
# Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. PostHog page views and error tracking; leave empty to send nothing.
# Production gets these from the VITE_POSTHOG_KEY and VITE_POSTHOG_HOST
# repository secrets (e.g., https://eu.i.posthog.com).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
